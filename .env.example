# Copy this file to .env.local and fill in the values.
# Both values are in the Supabase dashboard: Project Settings > API Keys,
# or run `pnpm exec supabase projects api-keys --project-ref <ref>`.

# Supabase API URL: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (safe to expose to the browser; RLS protects the data).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (Project Settings > API Keys, or `api-keys --reveal`).
# Server-only, never NEXT_PUBLIC_. Used only by the E2E tests to create and
# delete test users (emails ending in @deskmate.test).
SUPABASE_SECRET_KEY=
